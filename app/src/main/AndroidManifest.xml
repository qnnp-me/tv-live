<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 4.4 普通权限：只在开机等待阶段用 getRunningTasks(1) 读 top activity。
         厂商 ROM 屏蔽时查询返回 null，BootWaitPlan 自动退回 elapsed 兜底，不影响自启。 -->
    <uses-permission android:name="android.permission.GET_TASKS" />

    <!-- 无存储权限、无 android:banner、无 adaptive icon；landscape + configChanges 单 Activity。 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TvLive"
        android:usesCleartextTraffic="true">

        <!-- 批次 5a：不再锁 landscape。手机竖屏用 PhoneLayout，横屏手机复用电视布局；
             电视没有传感器，系统仍是 landscape，遥控行为不变。
             显式 resizeableActivity=true：避免部分系统把「未声明方向」的 App 放进
             size-compat 沙箱（旧尺寸窗口 + 缩放），那样 UI 会被整体缩放/letterbox，
             看起来像「布局没铺满」。
             批次 5b：configChanges 补齐方向/尺寸之外还会随旋转或 `wm size`/`wm density`
             改变的最小宽度、screenLayout 与密度——旋转（以及手机↔电视 sw 跨 600dp）
             都走 onConfigurationChanged 切布局，不重建 Activity、不重建播放器。 -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|navigation|density|fontScale|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.TvLive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 不声明桌面入口组件：TCL PackageVerifier 会拒绝任何第三方桌面声明。
             返回桌面只通过显式拉起 bama / 系统桌面选择器完成。 -->

        <!-- 开机信号适配器（批次 18）：静态注册、始终启用，开关关闭时也记 SKIP_DISABLED
             日志供诊断页读取。Android 4.4（TCL）静态 receiver 不受后台广播限制；
             action 必须与 BootActions 表一一对应，加厂商 action 时两处同步。
             导出是系统广播投递所需；代价是第三方也能发这些 action，靠 BootCoordinator
             的开关/5 分钟窗口/30 秒去重防打扰。 -->
        <receiver
            android:name=".boot.BootSignalReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <!-- 通用 -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
                <!-- 厂商候选：联发科 / TCL -->
                <action android:name="mediatek.intent.action.BOOT_COMPLETED" />
                <action android:name="com.tcl.intent.action.BOOT_COMPLETED" />
                <action android:name="com.tcl.tv.action.BOOT_COMPLETED" />
                <action android:name="com.tcl.action.BOOT_COMPLETED" />
            </intent-filter>
            <!-- 存储类广播带 file:// data，Android 4.4 的 IntentFilter 在 filter 没写
                 data 时不会匹配带 data 的 Intent，必须单独一条 filter。 -->
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <action android:name="android.intent.action.MEDIA_SCANNER_FINISHED" />
                <data android:scheme="file" />
            </intent-filter>
        </receiver>

        <!-- 开机等待 alarm 的落点（批次 20）：只由 BootLauncher 用显式 Intent 调度，
             不导出、不接系统广播。收到后查一次 top activity，决定继续轮询还是拉起。 -->
        <receiver
            android:name=".boot.BootAlarmReceiver"
            android:exported="false" />

        <!-- 拉起后的前台确认（批次 21）：巴马桌面会把拉起后的 MainActivity 盖掉，
             由 BootLauncher 排 2 秒一次的 alarm 检查并把 App 带回前台，最多 12 次。
             同样只接显式 Intent，不导出。 -->
        <receiver
            android:name=".boot.BootFrontCheckReceiver"
            android:exported="false" />
    </application>
</manifest>
