<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Holo NoActionBar + 全屏：电视端无常驻标题/状态栏；背景统一 ink，无纯黑大底。 -->
    <style name="Theme.TvLive" parent="@android:style/Theme.Holo.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
